{
  "manifest_version": 3,
  "name": "Watch Room",
  "version": "1.0.0",
  "description": "Share what you are watching on Twitch with your friends. Not affiliated with or endorsed by Twitch.",
  "permissions": [
    "storage",
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://localhost:8080/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
