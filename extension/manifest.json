{
  "manifest_version": 3,
  "name": "Twitch Room",
  "version": "1.0.0",
  "description": "Share what you are watching on Twitch with your friends.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["content.js"]
    }
  ]
}
