# Twitch Room configuration template.
# Copy to .env and fill in real values: cp .env.example .env
# See the "Configuration" table in README.md for the full reference.

# --- Twitch OAuth -----------------------------------------------------------
# Required for real Twitch authentication.
# Get these from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
# Must match the OAuth redirect URL registered in the Twitch Dev Console.
# The path corresponds to the /auth/twitch/callback route served by this service.
TWITCH_REDIRECT_URI=http://localhost:8080/auth/twitch/callback
# Where to redirect the browser after a successful Twitch login.
# Defaults to / if not set. The browser lands here with ?user_id=... attached.
APP_REDIRECT_AFTER_LOGIN=/

# --- Database ---------------------------------------------------------------
# Optional. If not set, the service uses an in-memory store.
# Format: postgres://username:password@host:port/database
DATABASE_DSN=postgres://user:password@localhost:5432/twitch_room

# --- Authentication ---------------------------------------------------------
# Optional. Static token accepted as `Authorization: Bearer <token>` and
# required by /metrics once set.
TWITCH_ROOM_AUTH_TOKEN=your_auth_token_here
# Enable the X-User-ID development shortcut. The service refuses to start with
# APP_ENV=production while this is true.
ALLOW_DEV_AUTH=true

# --- Service ----------------------------------------------------------------
PORT=8080
WATCH_STATE_TTL_MINUTES=5
# How often to re-resolve Twitch metadata for published watch states
# (only active when TWITCH_CLIENT_ID and TWITCH_CLIENT_SECRET are set).
WATCH_REFRESH_SECONDS=60
# "production" or empty. Set to production for real deployments.
APP_ENV=
# debug | info | warn | error
LOG_LEVEL=info
# Build version reported by /metrics as twitch_room_app_info{version=...}.
# docker-compose passes this to the Dockerfile build; a plain `go build`
# reports "dev".
APP_VERSION=dev

# --- TLS and proxy ----------------------------------------------------------
# Serve HTTPS directly instead of behind a reverse proxy.
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
# Plain-HTTP port that 301s to HTTPS, e.g. 80.
TLS_REDIRECT_PORT=
# Force the Secure flag on session cookies when TLS terminates at a proxy.
COOKIE_SECURE=false
# Comma-separated proxy networks whose X-Forwarded-* headers are trusted.
TRUSTED_PROXY_CIDRS=
# Comma-separated allowlist of Host header values. Empty accepts any host.
ALLOWED_HOSTS=
# Comma-separated list of CORS origins. Empty disables CORS headers.
ALLOWED_ORIGINS=

# --- Tests ------------------------------------------------------------------
# Optional. Postgres-backed repository tests skip unless this is set.
# TEST_DATABASE_DSN=postgres://twitch_room:twitch_room@localhost:5432/twitch_room?sslmode=disable
